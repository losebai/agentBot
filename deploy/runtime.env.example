# 复制到服务器 /opt/agentbot/runtime.env 并填写；不要提交实际凭据。
# 默认数据库与队列都使用持久卷中的 SQLite，无需 MySQL 或 Redis。
CHAT_DB_BACKEND=sqlite
CHAT_DB_SQLITE_PATH=/app/data/agent_bot.sqlite3
CHAT_QUEUE_BACKEND=sqlite
CHAT_QUEUE_SQLITE_PATH=/app/data/queue.sqlite3
AGENT_BOT_ADMIN_TOKEN=replace-with-a-new-admin-token
AGENT_BOT_MEDIA_DIRECTORY=/app/data/media

# 启动字段始终来自环境文件，修改后重启；容器内端口固定为 8080。
DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080
ONEBOT_V11_ACCESS_TOKEN=REPLACE_ME
CHAT_SESSION_SECRET=REPLACE_ME_TOO

# 运行配置、供应商与 MCP 的 URL/密钥通过管理页面保存到所选数据库。
# 可选 MySQL：改为 CHAT_DB_BACKEND=mysql，并配置容器可达地址。
# CHAT_DB_HOST=your-mysql-host
# CHAT_DB_PORT=3306
# CHAT_DB_USER=agentbot
# CHAT_DB_PASSWORD=replace-with-database-password
# CHAT_DB_NAME=agent_bot
# 可选 Redis：改为 CHAT_QUEUE_BACKEND=redis；失败不会切换后端。
# CHAT_REDIS_HOST=your-redis-host
# CHAT_REDIS_PORT=6379
# CHAT_REDIS_DB=0
# CHAT_REDIS_PASSWORD=replace-with-redis-password
# CHAT_REDIS_SSL=false
# CHAT_REDIS_KEY_PREFIX=agent:bot
