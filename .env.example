# Permanent bootstrap settings. Keep only these entries after import-env succeeds.
DISPATCH_CHAT_DB_HOST=127.0.0.1
DISPATCH_CHAT_DB_PORT=3306
DISPATCH_CHAT_DB_USER=dispatch_chat
DISPATCH_CHAT_DB_PASSWORD=replace-with-database-password
DISPATCH_CHAT_DB_NAME=agent_bot
DISPATCH_CHAT_REDIS_HOST=127.0.0.1
DISPATCH_CHAT_REDIS_PORT=6379
DISPATCH_CHAT_REDIS_DB=0
DISPATCH_CHAT_REDIS_PASSWORD=
DISPATCH_CHAT_REDIS_SSL=false
DISPATCH_CHAT_REDIS_KEY_PREFIX=agent:bot

# One-time import source below. These values are validated and written into MySQL by:
#   mysql < sql/dispatch_chat_setting.sql
#   uv run python -m dispatch_chat settings import-env
# After verifying `settings list`, remove everything below this comment from the real .env.

# NoneBot / OneBot V11
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
API_TIMEOUT=30
SUPERUSERS=[]
NICKNAME=[]
COMMAND_START=["/"]
COMMAND_SEP=["."]
SESSION_EXPIRE_TIMEOUT=120

# These deliberately short placeholders fail validation. Generate two different
# random values as documented in README before running `settings import-env`.
ONEBOT_V11_ACCESS_TOKEN=REPLACE_ME
ONEBOT_V11_SECRET=
ONEBOT_V11_WS_URLS=[]
ONEBOT_V11_API_ROOTS={}
DISPATCH_CHAT_SESSION_SECRET=REPLACE_ME_TOO

# dispatch-ai
DISPATCH_CHAT_AI_BASE_URL=http://127.0.0.1:8090/dispatch-ai
DISPATCH_CHAT_AI_TOKEN=
DISPATCH_CHAT_MODEL=Qwen/Qwen3-8B
DISPATCH_CHAT_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
DISPATCH_CHAT_IMAGE_MODEL=gpt-image-1
DISPATCH_CHAT_SYSTEM_PROMPT="请直接、友好地回应用户。"
# AI requests and LLM-generated command/keyword/tool replies share this timeout.
DISPATCH_CHAT_TIMEOUT_SECONDS=300
# Optional LLM request overrides. Leave commented to use provider defaults.
# DISPATCH_CHAT_LLM_MAX_TOKENS=4096
# DISPATCH_CHAT_LLM_TEMPERATURE=0.7
# DISPATCH_CHAT_LLM_TOP_P=0.9
# DISPATCH_CHAT_LLM_TOP_K=40
# DISPATCH_CHAT_LLM_MIN_P=0.05
# DISPATCH_CHAT_LLM_PRESENCE_PENALTY=0
# DISPATCH_CHAT_LLM_FREQUENCY_PENALTY=0
# DISPATCH_CHAT_LLM_REPETITION_PENALTY=1.1
# DISPATCH_CHAT_LLM_STOP=["END"]
# 普通聊天是否启用模型深度思考：true 开启，false 关闭；不设置则使用模型默认行为。
# DISPATCH_CHAT_LLM_ENABLE_THINKING=true
DISPATCH_CHAT_LLM_FORWARD_USER_NAME=false
# 联网 Agent 开关；与下方联网开关同时启用时，每次普通对话均提供联网工具。
DISPATCH_CHAT_AGENT_ENABLED=true
# 普通聊天 Agent 最大工具推理轮次（1–5）；不设置则沿用联网配置，画图工具默认 5 轮。
# DISPATCH_CHAT_AGENT_MAX_STEPS=3
# dispatch-ai 中已启用的通用 MCP 服务 code；最多 3 个，不填写 URL、Token 或认证头。
DISPATCH_CHAT_MCP_SERVICES=[]
# 始终提供 web_search；当前消息包含 HTTP/HTTPS URL 时加入 read_url，均由模型自主选择。
DISPATCH_CHAT_WEB_SEARCH_ENABLED=true
DISPATCH_CHAT_WEB_SEARCH_MAX_STEPS=3
DISPATCH_CHAT_IMAGE_RECOGNITION_ENABLED=true
DISPATCH_CHAT_MAX_IMAGES_PER_MESSAGE=4
DISPATCH_CHAT_IMAGE_GENERATION_ENABLED=false
DISPATCH_CHAT_IMAGE_TIMEOUT_SECONDS=60
DISPATCH_CHAT_IMAGE_RESPONSE_FORMAT=png
DISPATCH_CHAT_IMAGE_MAX_BYTES=10485760
# 本地工作流开启后替代云端图片生成，并通过下方 Chat MCP 供 Agent 调用。
DISPATCH_CHAT_LOCAL_WORKFLOW_ENABLED=false
DISPATCH_CHAT_LOCAL_WORKFLOW_BASE_URL=http://127.0.0.1:8188
# 启动时自动导入工作流 JSON 及其同名 .meta.json；留空时只使用数据库记录。
DISPATCH_CHAT_LOCAL_WORKFLOW_DIRECTORY=
DISPATCH_CHAT_LOCAL_WORKFLOW_DEFAULT_KEY=sdxl-lightning-4step
DISPATCH_CHAT_LOCAL_WORKFLOW_TIMEOUT_SECONDS=300
DISPATCH_CHAT_KEYWORD_AT_REPLIES={}
# 自动识别群聊第一句前 20 字内明确要求代发的 @ / 艾特 / at 指令。
DISPATCH_CHAT_AUTO_MENTION_ENABLED=true
# 是否向群聊 Agent 提供 mention_member，由 AI 根据上下文自主决定是否调用。
DISPATCH_CHAT_MENTION_TOOL_ENABLED=true

# Authenticated GPT-SoVITS MCP audio generation.
DISPATCH_CHAT_TTS_ENABLED=false
# GPT-SoVITS URL is active for tts_generate; Token/Model/Voice/Format are legacy fields.
DISPATCH_CHAT_TTS_URL=http://127.0.0.1:9880/tts
DISPATCH_CHAT_TTS_TOKEN=
DISPATCH_CHAT_TTS_MODEL=tts-1
DISPATCH_CHAT_TTS_SPEED=1.0
# Native audio options.
DISPATCH_CHAT_TTS_VOICE=alloy
DISPATCH_CHAT_TTS_RESPONSE_FORMAT=mp3
DISPATCH_CHAT_TTS_TIMEOUT_SECONDS=30
DISPATCH_CHAT_TTS_MAX_INPUT_CHARS=1000
DISPATCH_CHAT_TTS_MAX_AUDIO_BYTES=5242880
DISPATCH_CHAT_TTS_REFERENCE_AUDIO_PATH=
DISPATCH_CHAT_TTS_REFERENCE_TEXT=
DISPATCH_CHAT_TTS_REFERENCE_LANGUAGE=zh
DISPATCH_CHAT_TTS_TEXT_LANGUAGE=zh
DISPATCH_CHAT_TTS_OUTPUT_DIRECTORY=data/tts

# Chat MCP：为 Chat Agent 提供本次授权的工具；修改挂载配置后需重启。
DISPATCH_CHAT_MCP_ENABLED=false
# 需先启用 Chat MCP，并在 dispatch-ai 登记、启用和验证 Laya；此开关可热更新。
DISPATCH_CHAT_LAYA_ENABLED=false
# 一次性定时任务：先建 AI 的 ai_job 表、启用 AI Job，并将 AI_TOKEN 配为共享服务 Token。
DISPATCH_CHAT_JOB_ENABLED=false
DISPATCH_CHAT_SOLONCODE_ENABLED=false
DISPATCH_CHAT_JOB_POLL_SECONDS=5
DISPATCH_CHAT_MCP_MOUNT_PATH=/mcp
DISPATCH_CHAT_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","dispatch-chat:*"]
DISPATCH_CHAT_MCP_SESSION_TTL_SECONDS=120
DISPATCH_CHAT_MCP_MAX_SESSIONS=1000

# Inbound QQ access policy (private chats deny by default; groups allow unless blocked)
DISPATCH_CHAT_ALLOWED_USERS=[]
DISPATCH_CHAT_ALLOWED_GROUPS=[]
DISPATCH_CHAT_BLOCKED_USERS=[]
DISPATCH_CHAT_BLOCKED_GROUPS=[]
DISPATCH_CHAT_ALLOW_ALL=false
DISPATCH_CHAT_GROUP_SHARED_SESSION=false

# Automatic outbound speech (safe default: disabled, group-only).
# Enabling requires MCP, Laya, recent group context, and at least one group.
# interval uses the timer; message evaluates every eligible ordinary group text.
DISPATCH_CHAT_AUTO_SPEAK_ENABLED=false
DISPATCH_CHAT_AUTO_SPEAK_BOT_ID=
DISPATCH_CHAT_AUTO_SPEAK_GROUPS=[]
# Deprecated compatibility field: readable but ignored at runtime.
DISPATCH_CHAT_AUTO_SPEAK_USERS=[]
DISPATCH_CHAT_AUTO_SPEAK_TRIGGER_MODE=interval
DISPATCH_CHAT_AUTO_SPEAK_PROMPT="生成一句自然、友好、适合主动发给当前会话的简短消息。"
DISPATCH_CHAT_AUTO_SPEAK_LAYA_PROMPT="结合自动发言会话历史和当前群聊，判断现在是否适合主动发言；仅当发言自然、有明确价值且不会打扰群聊时选择 speak，否则选择 silent。"
DISPATCH_CHAT_AUTO_SPEAK_INITIAL_DELAY_SECONDS=60
DISPATCH_CHAT_AUTO_SPEAK_INTERVAL_SECONDS=3600
DISPATCH_CHAT_AUTO_SPEAK_MAX_REPLY_CHARS=500

# Chat limits and local history
DISPATCH_CHAT_MAX_INPUT_CHARS=2000
DISPATCH_CHAT_HISTORY_TURNS=6
DISPATCH_CHAT_HISTORY_MAX_CHARS=12000
DISPATCH_CHAT_HISTORY_TTL_SECONDS=604800
DISPATCH_CHAT_GROUP_RECENT_CONTEXT_ENABLED=false
DISPATCH_CHAT_GROUP_RECENT_CONTEXT_MESSAGES=10
DISPATCH_CHAT_GROUP_RECENT_CONTEXT_MAX_CHARS=4000
DISPATCH_CHAT_GROUP_RECENT_CONTEXT_TTL_SECONDS=604800
DISPATCH_CHAT_MEMORY_ENABLED=true
# MCP 开启后由 LLM 自主保存和按标签读取长期记忆，可在数据库热更新。
DISPATCH_CHAT_TAGGED_MEMORY_ENABLED=true
DISPATCH_CHAT_MEMORY_MAX_CHARS=4000
DISPATCH_CHAT_MEMORY_COMPRESSION_MAX_TOKENS=512
DISPATCH_CHAT_MEMORY_COMPRESSION_QUEUE_CAPACITY=64
DISPATCH_CHAT_DB_POOL_SIZE=8
DISPATCH_CHAT_DB_TIMEOUT_SECONDS=10
DISPATCH_CHAT_MODEL_CACHE_TTL_SECONDS=5
DISPATCH_CHAT_MAX_SESSIONS=1000
DISPATCH_CHAT_MAX_CONCURRENT_REQUESTS=4
DISPATCH_CHAT_COOLDOWN_SECONDS=2
DISPATCH_CHAT_CHUNK_CHARS=1200
DISPATCH_CHAT_MAX_REPLY_CHARS=6000
DISPATCH_CHAT_QUEUE_MAX_PENDING=1000
DISPATCH_CHAT_QUEUE_WORKERS=4
DISPATCH_CHAT_QUEUE_MEDIA_WORKERS=1
DISPATCH_CHAT_QUEUE_MAX_ATTEMPTS=3
DISPATCH_CHAT_QUEUE_RETRY_INITIAL_SECONDS=2
DISPATCH_CHAT_QUEUE_RETRY_MAX_SECONDS=30
DISPATCH_CHAT_QUEUE_JOB_TTL_SECONDS=900
DISPATCH_CHAT_QUEUE_RESULT_TTL_SECONDS=1800
DISPATCH_CHAT_USER_MESSAGE_LIMIT=0
DISPATCH_CHAT_USER_MESSAGE_WINDOW_SECONDS=86400
DISPATCH_CHAT_CONFIG_REFRESH_INTERVAL_SECONDS=5

# Matcher priorities
DISPATCH_CHAT_PRIORITY=50
DISPATCH_CHAT_RESET_PRIORITY=10

# Naraka / Xiaoheihe query (leave both credential fields empty to disable)
DISPATCH_CHAT_NARAKA_COOKIE=
DISPATCH_CHAT_NARAKA_HEYBOX_ID=
DISPATCH_CHAT_NARAKA_DEFAULT_ROLE_ID=
DISPATCH_CHAT_NARAKA_SERVER=163
DISPATCH_CHAT_NARAKA_SEASON=qianji
DISPATCH_CHAT_NARAKA_BATTLE_TID=5000001
DISPATCH_CHAT_NARAKA_TIMEOUT_SECONDS=15
DISPATCH_CHAT_NARAKA_COOLDOWN_SECONDS=10
DISPATCH_CHAT_NARAKA_MAX_CONCURRENT_REQUESTS=2

# Separate administrator credential: replace before starting agent-bot.
AGENT_BOT_ADMIN_TOKEN=replace-with-a-new-admin-token
# Optional provider credential references for Python ordinary AI (set real values locally).
# AGENT_BOT_PROVIDER_QWEN_KEY=replace-provider-key

# Phase three: persisted runtime fields (one-time import; edit later in management UI).
DISPATCH_CHAT_AGENT_BACKEND=java
# 媒体后端默认 Java；首次导入后通过管理配置持久化切换，失败不自动回退。
DISPATCH_CHAT_MEDIA_BACKEND=java
# 媒体目录为启动配置，不能在管理界面热修改；文件默认保存 24 小时。
AGENT_BOT_MEDIA_DIRECTORY=data/media
# DISPATCH_CHAT_PYTHON_AGENT_CODE=helper
# DISPATCH_CHAT_PYTHON_SEARCH_MCP_CODE=search
# MCP credentials stay in the service environment / .env, never imported into MySQL.
# AGENT_BOT_MCP_LIBRARY=replace-with-service-credential
