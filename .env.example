# 数据库和 Redis 启动引导参数，首次导入成功后继续保留。
CHAT_DB_HOST=127.0.0.1
CHAT_DB_PORT=3306
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=replace-with-database-password
CHAT_DB_NAME=agent_bot
CHAT_REDIS_HOST=127.0.0.1
CHAT_REDIS_PORT=6379
CHAT_REDIS_DB=0
CHAT_REDIS_PASSWORD=
CHAT_REDIS_SSL=false
CHAT_REDIS_KEY_PREFIX=agent:bot

# 以下机器人运行字段仅供首次导入，先执行统一 SQL 初始化，再将配置写入 MySQL：
#   mysql -h 127.0.0.1 -u root -p agent_bot --execute="source sql/agent_bot_init.sql"
#   uv run agent-bot settings import-env
# 核对 settings list 后可移除已入库字段；保留数据库、Redis、管理员、媒体目录和供应商/MCP 凭据。

# NoneBot / OneBot V11
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
API_TIMEOUT=30
SUPERUSERS=[]
NICKNAME=[]
COMMAND_START=["/"]
COMMAND_SEP=["."]
SESSION_EXPIRE_TIMEOUT=120

# These deliberately short placeholders fail validation. Generate two different
# random values as documented in README before running `settings import-env`.
ONEBOT_V11_ACCESS_TOKEN=REPLACE_ME
ONEBOT_V11_SECRET=
ONEBOT_V11_WS_URLS=[]
ONEBOT_V11_API_ROOTS={}
CHAT_SESSION_SECRET=REPLACE_ME_TOO

# Python 模型目录中的别名，供应商凭据由管理端的环境变量引用解析。
CHAT_MODEL=Qwen/Qwen3-8B
CHAT_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
CHAT_IMAGE_MODEL=gpt-image-1
CHAT_SYSTEM_PROMPT="请直接、友好地回应用户。"
# AI requests and LLM-generated command/keyword/tool replies share this timeout.
CHAT_TIMEOUT_SECONDS=300
# Optional LLM request overrides. Leave commented to use provider defaults.
# CHAT_LLM_MAX_TOKENS=4096
# CHAT_LLM_TEMPERATURE=0.7
# CHAT_LLM_TOP_P=0.9
# CHAT_LLM_TOP_K=40
# CHAT_LLM_MIN_P=0.05
# CHAT_LLM_PRESENCE_PENALTY=0
# CHAT_LLM_FREQUENCY_PENALTY=0
# CHAT_LLM_REPETITION_PENALTY=1.1
# CHAT_LLM_STOP=["END"]
# 普通聊天是否启用模型深度思考：true 开启，false 关闭；不设置则使用模型默认行为。
# CHAT_LLM_ENABLE_THINKING=true
CHAT_LLM_FORWARD_USER_NAME=false
# 联网 Agent 开关；与下方联网开关同时启用时，每次普通对话均提供联网工具。
CHAT_AGENT_ENABLED=true
# 普通聊天 Agent 最大工具推理轮次（1–5）；不设置则沿用联网配置，画图工具默认 5 轮。
# CHAT_AGENT_MAX_STEPS=3
# 本项目已登记并启用的通用 MCP 服务 code；最多 3 个，不填写 URL、Token 或认证头。
CHAT_MCP_SERVICES=[]
# 始终提供 web_search；当前消息包含 HTTP/HTTPS URL 时加入 read_url，均由模型自主选择。
CHAT_WEB_SEARCH_ENABLED=true
CHAT_WEB_SEARCH_MAX_STEPS=3
CHAT_IMAGE_RECOGNITION_ENABLED=true
CHAT_MAX_IMAGES_PER_MESSAGE=4
CHAT_IMAGE_GENERATION_ENABLED=false
CHAT_IMAGE_TIMEOUT_SECONDS=60
CHAT_IMAGE_RESPONSE_FORMAT=png
CHAT_IMAGE_MAX_BYTES=10485760
# 本地工作流开启后替代云端图片生成，并通过下方 Chat MCP 供 Agent 调用。
CHAT_LOCAL_WORKFLOW_ENABLED=false
CHAT_LOCAL_WORKFLOW_BASE_URL=http://127.0.0.1:8188
# 启动时自动导入工作流 JSON 及其同名 .meta.json；留空时只使用数据库记录。
CHAT_LOCAL_WORKFLOW_DIRECTORY=
CHAT_LOCAL_WORKFLOW_DEFAULT_KEY=sdxl-lightning-4step
CHAT_LOCAL_WORKFLOW_TIMEOUT_SECONDS=300
CHAT_KEYWORD_AT_REPLIES={}
# 自动识别群聊第一句前 20 字内明确要求代发的 @ / 艾特 / at 指令。
CHAT_AUTO_MENTION_ENABLED=true
# 是否向群聊 Agent 提供 mention_member，由 AI 根据上下文自主决定是否调用。
CHAT_MENTION_TOOL_ENABLED=true

# Authenticated GPT-SoVITS MCP audio generation.
CHAT_TTS_ENABLED=false
# GPT-SoVITS URL is active for tts_generate; Token/Model/Voice/Format are legacy fields.
CHAT_TTS_URL=http://127.0.0.1:9880/tts
CHAT_TTS_TOKEN=
CHAT_TTS_MODEL=tts-1
CHAT_TTS_SPEED=1.0
# Native audio options.
CHAT_TTS_VOICE=alloy
CHAT_TTS_RESPONSE_FORMAT=mp3
CHAT_TTS_TIMEOUT_SECONDS=30
CHAT_TTS_MAX_INPUT_CHARS=1000
CHAT_TTS_MAX_AUDIO_BYTES=5242880
CHAT_TTS_REFERENCE_AUDIO_PATH=
CHAT_TTS_REFERENCE_TEXT=
CHAT_TTS_REFERENCE_LANGUAGE=zh
CHAT_TTS_TEXT_LANGUAGE=zh
CHAT_TTS_OUTPUT_DIRECTORY=data/tts

# Chat MCP：为 Chat Agent 提供本次授权的工具；修改挂载配置后需重启。
CHAT_MCP_ENABLED=false
# 一次性定时任务：先手动执行 Python Job 增量 SQL，并启用上方 Chat MCP 请求授权。
CHAT_JOB_ENABLED=false
CHAT_JOB_POLL_SECONDS=5
CHAT_MCP_MOUNT_PATH=/mcp
CHAT_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","chat:*"]
CHAT_MCP_SESSION_TTL_SECONDS=120
CHAT_MCP_MAX_SESSIONS=1000

# Inbound QQ access policy (private chats deny by default; groups allow unless blocked)
CHAT_ALLOWED_USERS=[]
CHAT_ALLOWED_GROUPS=[]
CHAT_BLOCKED_USERS=[]
CHAT_BLOCKED_GROUPS=[]
CHAT_ALLOW_ALL=false
CHAT_GROUP_SHARED_SESSION=false

# 群聊自动发言默认关闭；Python 直接调用目录中已启用的 Laya MCP。
# 在管理界面登记 general 类型的服务，授权 laya_predict；凭据放在服务端环境变量中。
# 两种模式均需启用群近期上下文；interval 按间隔判断，message 按合格群消息判断。
CHAT_AUTO_SPEAK_ENABLED=false
# 改成管理端登记的 MCP code 后再启用。
CHAT_AUTO_SPEAK_MCP_CODE=auto-speak
CHAT_AUTO_SPEAK_BOT_ID=
CHAT_AUTO_SPEAK_GROUPS=[]
CHAT_AUTO_SPEAK_TRIGGER_MODE=interval
CHAT_AUTO_SPEAK_PROMPT="生成一句自然、友好、适合主动发给当前会话的简短消息。"
CHAT_AUTO_SPEAK_LAYA_PROMPT="结合自动发言会话历史和当前群聊，判断现在是否适合主动发言；仅当发言自然、有明确价值且不会打扰群聊时选择 speak，否则选择 silent。"
CHAT_AUTO_SPEAK_INITIAL_DELAY_SECONDS=60
CHAT_AUTO_SPEAK_INTERVAL_SECONDS=3600
CHAT_AUTO_SPEAK_MAX_REPLY_CHARS=500

# Chat limits and local history
CHAT_MAX_INPUT_CHARS=2000
CHAT_HISTORY_TURNS=6
CHAT_HISTORY_MAX_CHARS=12000
CHAT_HISTORY_TTL_SECONDS=604800
CHAT_GROUP_RECENT_CONTEXT_ENABLED=false
CHAT_GROUP_RECENT_CONTEXT_MESSAGES=10
CHAT_GROUP_RECENT_CONTEXT_MAX_CHARS=4000
CHAT_GROUP_RECENT_CONTEXT_TTL_SECONDS=604800
CHAT_MEMORY_ENABLED=true
# MCP 开启后由 LLM 自主保存和按标签读取长期记忆，可在数据库热更新。
CHAT_TAGGED_MEMORY_ENABLED=true
CHAT_MEMORY_MAX_CHARS=4000
CHAT_MEMORY_COMPRESSION_MAX_TOKENS=512
CHAT_MEMORY_COMPRESSION_QUEUE_CAPACITY=64
CHAT_DB_POOL_SIZE=8
CHAT_DB_TIMEOUT_SECONDS=10
CHAT_MAX_SESSIONS=1000
CHAT_MAX_CONCURRENT_REQUESTS=4
CHAT_COOLDOWN_SECONDS=2
CHAT_CHUNK_CHARS=1200
CHAT_MAX_REPLY_CHARS=6000
CHAT_QUEUE_MAX_PENDING=1000
CHAT_QUEUE_WORKERS=4
CHAT_QUEUE_MEDIA_WORKERS=1
CHAT_QUEUE_MAX_ATTEMPTS=3
CHAT_QUEUE_RETRY_INITIAL_SECONDS=2
CHAT_QUEUE_RETRY_MAX_SECONDS=30
CHAT_QUEUE_JOB_TTL_SECONDS=900
CHAT_QUEUE_RESULT_TTL_SECONDS=1800
CHAT_USER_MESSAGE_LIMIT=0
CHAT_USER_MESSAGE_WINDOW_SECONDS=86400
CHAT_CONFIG_REFRESH_INTERVAL_SECONDS=5

# Matcher priorities
CHAT_PRIORITY=50
CHAT_RESET_PRIORITY=10

# Naraka / Xiaoheihe query (leave both credential fields empty to disable)
CHAT_NARAKA_COOKIE=
CHAT_NARAKA_HEYBOX_ID=
CHAT_NARAKA_DEFAULT_ROLE_ID=
CHAT_NARAKA_SERVER=163
CHAT_NARAKA_SEASON=qianji
CHAT_NARAKA_BATTLE_TID=5000001
CHAT_NARAKA_TIMEOUT_SECONDS=15
CHAT_NARAKA_COOLDOWN_SECONDS=10
CHAT_NARAKA_MAX_CONCURRENT_REQUESTS=2

# Separate administrator credential: replace before starting agent-bot.
AGENT_BOT_ADMIN_TOKEN=replace-with-a-new-admin-token
# 模型供应商的 URL 和 API Key 在管理页面填写并保存到 MySQL，不读取环境变量。

# 媒体目录为启动配置，不能在管理界面热修改；文件默认保存 24 小时。
AGENT_BOT_MEDIA_DIRECTORY=data/media
# CHAT_PYTHON_AGENT_CODE=helper
# CHAT_PYTHON_SEARCH_MCP_CODE=search
# MCP 服务地址和访问令牌在管理页面填写并保存到 MySQL。
