# 静态启动配置：保留在 .env 或进程环境，修改后重启服务。
# 运行配置在管理页面保存到数据库，不从环境变量读取。
# 新安装：agent-bot database init，然后 agent-bot settings init。

# 数据库明确二选一；未设置 CHAT_DB_BACKEND 时兼容旧部署，默认为 mysql。
CHAT_DB_BACKEND=sqlite
CHAT_DB_SQLITE_PATH=data/agent_bot.sqlite3
# 使用 MySQL 时改为 mysql，并填写以下连接参数（先创建独立数据库）。
# CHAT_DB_HOST=127.0.0.1
# CHAT_DB_PORT=3306
# CHAT_DB_USER=agent_bot
# CHAT_DB_PASSWORD=replace-with-database-password
# CHAT_DB_NAME=agent_bot

# Redis 继续用于队列，SQLite 不替代 Redis。
CHAT_REDIS_HOST=127.0.0.1
CHAT_REDIS_PORT=6379
CHAT_REDIS_DB=0
CHAT_REDIS_PASSWORD=
CHAT_REDIS_SSL=false
CHAT_REDIS_KEY_PREFIX=agent:bot

# 管理员密码：留空或不配置时直接进入系统，所有管理接口均无需密码。
# 沿用旧配置名；可设置 8-256 位字母、数字或符号，不含空格，修改后重启。
# 含 # 等 dotenv 特殊字符的密码需用引号包裹；旧随机令牌仍可作为密码。
AGENT_BOT_ADMIN_TOKEN=

# 媒体存储目录不入包，修改后重启。
AGENT_BOT_MEDIA_DIRECTORY=data/media

# NoneBot、OneBot 及固定服务资源；管理页面中只读显示。
CHAT_LOCAL_WORKFLOW_DIRECTORY=
CHAT_TTS_OUTPUT_DIRECTORY=data/tts
CHAT_MCP_ENABLED=false
CHAT_MCP_MOUNT_PATH=/mcp
CHAT_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","chat:*"]
CHAT_MCP_SESSION_TTL_SECONDS=120
CHAT_MCP_MAX_SESSIONS=1000
ONEBOT_V11_ACCESS_TOKEN=REPLACE_ME
CHAT_SESSION_SECRET=REPLACE_ME_TOO
CHAT_MEMORY_COMPRESSION_QUEUE_CAPACITY=64
CHAT_DB_POOL_SIZE=8
CHAT_DB_TIMEOUT_SECONDS=10
CHAT_QUEUE_MAX_PENDING=1000
CHAT_QUEUE_WORKERS=4
CHAT_QUEUE_MEDIA_WORKERS=1
CHAT_QUEUE_MAX_ATTEMPTS=3
CHAT_QUEUE_RETRY_INITIAL_SECONDS=2
CHAT_QUEUE_RETRY_MAX_SECONDS=30
CHAT_QUEUE_JOB_TTL_SECONDS=900
CHAT_QUEUE_RESULT_TTL_SECONDS=1800
CHAT_PRIORITY=50
CHAT_RESET_PRIORITY=10
DRIVER=~fastapi+~websockets
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
API_TIMEOUT=30
SUPERUSERS=[]
COMMAND_START=["/"]
COMMAND_SEP=["."]
SESSION_EXPIRE_TIMEOUT=120.0
ONEBOT_V11_SECRET=

# OneBot 正向 WS 地址和 HTTP API 地址在管理页面保存到数据库，修改后重启连接。

# 聊天模型、提示词、访问名单、业务开关和生成参数：初始化后在管理页面修改。
# 机器人名称在“机器人配置 → 运行配置”保存到数据库，每行一个触发名称或别名。
# 已有旧 .env 可显式运行 settings import-env，仅首次导入动态字段。
# 供应商与 MCP 的 URL、协议和密钥通过管理页面录入数据库。
